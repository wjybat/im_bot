# Live model.
IM_BOT_PI_PROVIDER=dmall-ai
IM_BOT_PI_BASE_URL=https://ai-router.dmall.com/v1
# 模型可设置，flash、luna级的即可
IM_BOT_PI_MODEL=deepseek-v4.1-flash-ali-new
IM_BOT_PI_THINKING=high

IM_BOT_PI_AUTH_FILE=var/pi-auth/auth.json
IM_BOT_PI_MEMORY_FILE=var/office-memory.db
IM_BOT_PI_MEMORY_THINKING=low
IM_BOT_PI_MEMORY_EXTRACTION_TIMEOUT_MS=120000
IM_BOT_PI_MEMORY_EXTRACTION_MAX_OUTPUT_TOKENS=4096
IM_BOT_PI_MEMORY_IDLE_GAP_MINUTES=90
IM_BOT_PI_MEMORY_CHUNK_TOKENS=1400
IM_BOT_PI_MEMORY_CHUNK_MESSAGES=20
IM_BOT_PI_MEMORY_CONTEXT_MESSAGES=5
IM_BOT_PI_MEMORY_MAX_CHUNKS=3
IM_BOT_PI_MEMORY_MAX_ATTEMPTS=3
IM_BOT_PI_MEMORY_CONTEXT_TOKENS=12000
IM_BOT_PI_MEMORY_PREPARE_MAX_WINDOWS=16
IM_BOT_PI_MEMORY_PREPARE_MIN_WINDOW_SECONDS=60

# Offline memory warming: background sync + fact extraction at fixed daily
# Shanghai times so interactive requests hit a warm cache. Comma-separated
# HH:MM list; empty disables the warmer.
IM_BOT_PI_MEMORY_WARM_SCHEDULE=07:30,12:30,23:00
IM_BOT_PI_MEMORY_WARM_INITIAL_DELAY_SECONDS=30
# Fresh-start initial warm-up lookback (first run after startup).
IM_BOT_PI_MEMORY_WARM_INITIAL_LOOKBACK_DAYS=7
# Regular warm-up lookback (rolling window; idempotent, covered ranges are
# never re-pulled).
IM_BOT_PI_MEMORY_WARM_LOOKBACK_DAYS=14
IM_BOT_PI_MEMORY_WARM_MAX_CHUNKS=30

# Welcome card re-send throttle: restarts within this window stay silent
# (state persisted in var/welcome-card.json). 0 disables throttling.
IM_BOT_PI_WELCOME_CARD_THROTTLE_MINUTES=15

# Recent conversation history injected as context (0 disables; 8 turns ≈ 4 Q&A pairs).
IM_BOT_PI_HISTORY_TURNS=8
IM_BOT_PI_HISTORY_TURN_CHARS=4000
IM_BOT_PI_CONVERSATION_IDLE_RESET_MINUTES=60

# Lark host boundary.
# Optional override when lark-cli is not discoverable from PATH or ~/.npm-global/bin:
# IM_BOT_LARK_CLI=/absolute/path/to/lark-cli
# IM_BOT_ALLOWED_USER_OPEN_ID=
IM_BOT_PI_TIMEOUT_MS=1200000
IM_BOT_PI_TOOL_TIMEOUT_MS=120000
# Retries for transient stream interruptions (connection cut mid-turn).
IM_BOT_PI_STREAM_RETRIES=2
IM_BOT_PI_STREAM_RETRY_DELAY_MS=2000
# Retries for upstream model service errors (HTTP 408/409/429/5xx, e.g.
# "模型服务异常" from the AI router). Each retry re-runs the agent turn.
IM_BOT_PI_UPSTREAM_RETRIES=3
IM_BOT_PI_AUTH_VERIFY_INTERVAL_MS=600000
# Per-message auth verification retries (absorbs transient lark-cli verify flakiness).
IM_BOT_PI_AUTH_VERIFY_MESSAGE_ATTEMPTS=3
IM_BOT_PI_AUTH_VERIFY_MESSAGE_RETRY_DELAY_MS=2000
IM_BOT_PI_MAX_QUEUE=20
IM_BOT_PI_MAX_INPUT_CHARS=20000
IM_BOT_PI_MAX_REPLY_CHARS=12000
IM_BOT_PI_MAX_TOOL_OUTPUT_CHARS=100000
IM_BOT_PI_MAX_MESSAGE_PAGES=5
IM_BOT_PI_MAX_TURNS=50
IM_BOT_PI_REPLY_ON_ERROR=true
IM_BOT_PI_PROCESSING_REPLY=已收到，正在读取办公上下文并整理，请稍候。

# GPT-5.6 Luna reference pricing in USD per 1M tokens. 更换模型后可能需要更换对应的模型计费文档，目前按使用模型与luna同规格预估价格
IM_BOT_PI_PRICE_SOURCE=https://developers.openai.com/api/docs/models/gpt-5.6-luna
IM_BOT_PI_PRICE_AS_OF=2026-08-26
IM_BOT_PI_PRICE_INPUT_PER_MILLION=0.20
IM_BOT_PI_PRICE_CACHE_READ_PER_MILLION=0.02
IM_BOT_PI_PRICE_CACHE_WRITE_PER_MILLION=0.25
IM_BOT_PI_PRICE_OUTPUT_PER_MILLION=1.20
IM_BOT_PI_PRICE_LONG_CONTEXT_THRESHOLD=272000
IM_BOT_PI_PRICE_LONG_INPUT_PER_MILLION=0.40
IM_BOT_PI_PRICE_LONG_CACHE_READ_PER_MILLION=0.04
IM_BOT_PI_PRICE_LONG_CACHE_WRITE_PER_MILLION=0.50
IM_BOT_PI_PRICE_LONG_OUTPUT_PER_MILLION=1.80

# Keep false until a reviewed write-confirmation protocol exists.
IM_BOT_PI_ALLOW_USER_WRITES=false

# ===== Multi-user mode (single tenant, several colleagues) =====
# Comma-separated open_ids of colleagues allowed to use the bot.
# Non-empty enables multi-user mode (or set IM_BOT_PI_MULTI_USER=1 explicitly).
# 目前留空 = 机器人应用后台设置可用范围内所有人可授权使用
# IM_BOT_PI_ALLOWED_USER_OPEN_IDS=ou_xxx,ou_yyy
# 启动多用户模式
IM_BOT_PI_MULTI_USER=1
# Feishu custom-app credentials (the one app shared inside the company).
IM_BOT_PI_MULTI_APP_ID=cli_xxx
IM_BOT_PI_MULTI_APP_SECRET=xxx
# OAuth callback endpoint (reachable by colleagues' browsers; for local runs
# use a tunnel such as ngrok and put its URL here).
# 需确保飞书用户所在网络环境可访问该项目服务所部署的地址 且在飞书开发者后台设置机器人的安全设置里重定向url添加: "http://部署地址:端口/oauth/callback"
# IM_BOT_PI_OAUTH_CALLBACK_PORT=37731
# IM_BOT_PI_OAUTH_PUBLIC_BASE_URL=http://部署地址:37731

# ===== Memory API (external function interface for other agent products) =====
# HTTP service started inside the bot process; exposes /v1/search_facts,
# /v1/search_messages, /v1/get_evidence, /v1/search_entities, /v1/get_entity,
# /v1/get_status, /v1/refresh_messages, /v1/refresh_context as bearer-token
# JSON POST endpoints. 0 (default) disables the service.
IM_BOT_PI_MEMORY_API_PORT=4320
# Listen address: 127.0.0.1 only allows local calls; change to the server LAN
# IP (e.g. 10.12.6.143) or 0.0.0.0 so the external agent product can reach it.
IM_BOT_PI_MEMORY_API_HOST=0.0.0.0
# Comma-separated service tokens; required when the port is enabled.
# Issue one per caller product; revoke by removing it here and restarting.
IM_BOT_PI_MEMORY_API_KEYS=change-me-service-token
# Per-token rate limits and per-owner+window refresh cooldown.
IM_BOT_PI_MEMORY_API_RATE_PER_MINUTE=60
IM_BOT_PI_MEMORY_API_DAILY_QUOTA=10000
IM_BOT_PI_MEMORY_API_REFRESH_COOLDOWN_SECONDS=300
