# Optional absolute executable paths. launchd installer fills these automatically.
IM_BOT_LARK_CLI=lark-cli
IM_BOT_CODEX_CLI=codex

# Network access is required for lark-cli. Writes are confined to im_bot/runtime.
IM_BOT_CODEX_SANDBOX=workspace-write
# IM_BOT_CODEX_MODEL=
IM_BOT_CODEX_TIMEOUT_MS=600000
IM_BOT_AUTH_VERIFY_INTERVAL_MS=600000

# Single-owner safety boundary. Empty = resolve the currently authorized Lark user at startup.
# IM_BOT_ALLOWED_USER_OPEN_ID=

IM_BOT_MAX_QUEUE=20
IM_BOT_MAX_INPUT_CHARS=20000
IM_BOT_MAX_REPLY_CHARS=12000
IM_BOT_REPLY_ON_ERROR=true

# Keep false until a reviewed confirmation protocol is implemented.
IM_BOT_ALLOW_USER_WRITES=false
